{
  "name": "figma-courses-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel-friendly responsive courses catalog: HTML, vanilla JavaScript, SCSS and BEM.",
  "scripts": {
    "dev": "serve .",
